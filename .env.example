# Copy this file to .env and insert a newly generated key.
# Never commit the real .env file.
#
# Hosted generation works with any OpenAI-compatible Chat Completions API.
# LLM_PROVIDER presets: openai, aihubmix, deepseek, openrouter, anthropic,
# siliconflow, ollama (local, no key) or custom (set LLM_BASE_URL).
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional overrides; empty values use the preset defaults.
LLM_MODEL=
LLM_BASE_URL=

# Legacy variables are still read when LLM_API_KEY is empty and LLM_PROVIDER=aihubmix.
# AIHUBMIX_API_KEY=
